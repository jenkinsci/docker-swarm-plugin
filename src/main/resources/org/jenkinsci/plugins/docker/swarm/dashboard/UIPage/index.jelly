<?jelly escape-by-default='false'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler"
    xmlns:l="/lib/layout">
    <l:layout title="Docker Swarm Status" type="one-column">
        <j:set var="dbrd" value="${it.dashboard}" />
        <l:header>
            <link rel="stylesheet" href="${resURL}/plugin/docker-swarm/css/clr-ui.min.css" />
            <link rel="stylesheet" href="${resURL}/plugin/docker-swarm/css/clr-icons.min.css" />
            <link rel="stylesheet" href="${resURL}/plugin/docker-swarm/css/custom-styles.css" />
        </l:header>
        <l:main-panel>
            <div class="content-container">
                <div class="clr-row">
                    <div class="clr-col-4">
                        <div class="card info-block">
                            <div class="card-header">
                                System Overview
                            </div>
                            <div class="card-block">
                                <div class="card-text">
                                    <div class="clr-row">
                                        <div class="clr-col-6">
                                            <div class="chart-container" style="min-height: 250px;">
                                                <canvas id="cpu-usage-chart"></canvas>
                                            </div>
                                        </div>
                                        <div class="clr-col-6">
                                            <div class="chart-container" style="min-height: 250px;">
                                                <canvas id="mem-usage-chart"></canvas>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div>
                            <st:include page="swarm-queue.jelly"/>
                        </div>
                    </div>
                    <div class="clr-col-8">
                        <st:include page="swarm-status.jelly"/>
                    </div>
                </div>
            </div>
            <script type="text/javascript" src="${resURL}/plugin/docker-swarm/js/clr-icons.min.js"></script>
            <script type="text/javascript" src="${resURL}/plugin/docker-swarm/js/Chart.min.js"></script>
            <script type="text/javascript" src="${resURL}/plugin/docker-swarm/js/chartjs-plugin-datalabels.js"></script>
            <script type="text/javascript" src="${resURL}/plugin/docker-swarm/js/custom-script.js"></script>
            <script>
                drawCpuChart(document, ${dbrd.cpuUsage});
                drawMemoryChart(document, ${dbrd.memoryUsage});
                <j:forEach items="${dbrd.nodes}" var="node">
                    drawNodeCpuChart(document, '${node.safeId}', ${node.cpuUsageJson});
                    drawNodeMemoryChart(document, '${node.safeId}', ${node.memoryUsageJson});
                </j:forEach>
            </script>
        </l:main-panel>
    </l:layout>
</j:jelly>
